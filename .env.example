# Copy to .env and export these values before running the CLI.
# The project reads process environment variables; it does not load .env automatically.
# No provider credentials are required for the local/default run.

# OpenAI-compatible API settings. Required only when using API classification or OCR.
GHOST_DATA_API_KEY=
GHOST_DATA_API_BASE=https://api.openai.com/v1
GHOST_DATA_CLASSIFIER_MODEL=gpt-4o-mini
GHOST_DATA_VISION_MODEL=gpt-4o-mini

# OCR backend: auto, api, rapidocr, or tesseract.
GHOST_DATA_OCR_BACKEND=auto
GHOST_DATA_TESSERACT=tesseract
GHOST_DATA_OCR_DPI=200
GHOST_DATA_OCR_TIMEOUT=90

# Dataset location and local processing artifacts (paths are relative to the working directory).
GHOST_DATASET=dataset
GHOST_DATA_LLM_CACHE=.local/llm_cache
GHOST_DATA_OCR_CACHE=.local/ocr_cache
GHOST_DATA_TOKEN_LOG=.local/token_usage.jsonl
GHOST_DATA_EVIDENCE_ERRORS=.local/evidence_errors.jsonl
GHOST_DATA_UNMAPPED_TYPES=.local/unmapped_resource_types.jsonl
GHOST_DATA_OCR_DUMP=.local/ocr_dump.txt
